#!/usr/bin/env bash
# pre-commit: 주석·문체 게이트
# 활성화: git config core.hooksPath .githooks  (clone마다 1회)
# 의도적 우회는 git commit --no-verify (사유를 커밋 메시지에 남길 것)
#
# 이 저장소에는 CI 가 없다. ArgoCD 가 main 을 pull 로 reconcile 할 뿐이므로 이 훅이 유일한
# 강제 지점이다. 규칙 SSOT 는 iac-module-library 의 docs/conventions.md 와 docs/writing-style.md 다.
#
# ⛔ 매니페스트 렌더 결과는 검사하지 않는다. 그것은 ArgoCD 가 sync 시점에 판정하고, 여기서
#    흉내 내면 두 판정이 갈린다.
set -euo pipefail

# 시크릿 게이트. staged 내용을 gitleaks 규칙으로 본다. 이력에 들어간 시크릿은 force-push로도
# 원격에서 지워지지 않으므로(PR ref가 옛 커밋을 붙든다) 커밋 전이 유일하게 싼 지점이다.
# CI의 verify.yml이 같은 도구로 전체 이력을 다시 본다.
command -v gitleaks >/dev/null || {
  echo "  ✗ gitleaks 가 없다: brew install gitleaks (clone마다 1회)" >&2
  exit 1
}
echo "[pre-commit] 시크릿 검사(gitleaks)"
gitleaks git --staged --redact --no-banner --exit-code 1 .

changed=$(git diff --cached --name-only --diff-filter=ACMR)

targets=$(printf '%s\n' "$changed" |
  grep -E '^(applicationsets|addons|projects|clusters|bootstrap|tests)/.*\.(yaml|sh)$|\.md$|^scripts/.*\.py$|^\.githooks/|^\.github/workflows/.*\.yml$' || true)

[ -z "$targets" ] && exit 0

echo "[pre-commit] 주석·문체 규칙 검사"
# shellcheck disable=SC2086
python3 scripts/validate-comment-conventions.py $targets

# 셸 게이트. bash -n 은 문법만 보고, shellcheck 는 인용·확장·종료코드 실수를 본다.
# argocd-seed.sh 는 workbench 에서 사람이 손으로 돌리는 스크립트라 깨진 채 머지되면
# 부트스트랩 한가운데서 드러난다. -x 는 source 추적이고, 이 저장소에는 source 가 없지만
# 형제 저장소 훅과 같은 호출을 유지한다.
# 훅 파일 자신도 셸이다. git 훅은 이름이 규격이라 확장자를 못 붙여 \.sh$ 에 안 걸리므로
# 이름으로 따로 적는다. bash -n·shellcheck 는 파싱·정적 분석이라 훅을 다시 실행하지 않는다
# (재귀가 아니다). 위의 조기 exit 뒤쪽에 있는 문법 오류는 훅을 실행해도 드러나지 않는다. 실행이
# 그 줄에 도달하지 못하기 때문이고, 파일 전체를 보는 것은 bash -n 뿐이다. 남는
# 사각지대는 이 검사보다 앞선 줄이 망가져 게이트 자체를 건너뛰는 경우 하나다.
# pre-push 는 이 저장소에 없지만 형제 저장소 훅과 패턴을 같게 유지한다.
sh_staged=$(printf '%s\n' "$changed" | grep -E '\.sh$|^\.githooks/pre-(commit|push)$' || true)
if [ -n "$sh_staged" ]; then
  echo "[pre-commit] 셸 변경 감지. 문법·정적 검사"
  command -v shellcheck >/dev/null || {
    echo "  ✗ shellcheck 가 없다: brew install shellcheck (clone마다 1회)" >&2
    exit 1
  }
  for f in $sh_staged; do
    bash -n "$f"
    shellcheck -x "$f"
  done
fi

echo "[pre-commit] 게이트 통과 ✓"
